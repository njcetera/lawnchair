<?xml version="1.0" encoding="utf-8"?>
<!--
    AresLauncher — Material You foundation, DARK roles.
    Companion to values/ares_material_you.xml; see that file for the full explanation. Tonal mapping
    follows the standard M3 dynamic dark scheme over the same Monet aliases.
-->
<resources>

    <style name="ThemeOverlay.Ares.MaterialYou" parent="">
        <!-- Primary -->
        <item name="colorPrimary">@color/system_accent1_200</item>
        <item name="colorOnPrimary">@color/system_accent1_800</item>
        <item name="colorPrimaryContainer">@color/system_accent1_700</item>
        <item name="colorOnPrimaryContainer">@color/system_accent1_100</item>
        <item name="colorPrimaryInverse">@color/system_accent1_600</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/system_accent2_200</item>
        <item name="colorOnSecondary">@color/system_accent2_800</item>
        <item name="colorSecondaryContainer">@color/system_accent2_700</item>
        <item name="colorOnSecondaryContainer">@color/system_accent2_100</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/system_accent3_200</item>
        <item name="colorOnTertiary">@color/system_accent3_800</item>
        <item name="colorTertiaryContainer">@color/system_accent3_700</item>
        <item name="colorOnTertiaryContainer">@color/system_accent3_100</item>

        <!-- Surfaces / background -->
        <item name="android:colorBackground">@color/system_neutral1_900</item>
        <item name="colorOnBackground">@color/system_neutral1_100</item>
        <item name="colorSurface">@color/system_neutral1_900</item>
        <item name="colorOnSurface">@color/system_neutral1_100</item>
        <item name="colorSurfaceVariant">@color/system_neutral2_700</item>
        <item name="colorOnSurfaceVariant">@color/system_neutral2_200</item>
        <item name="colorSurfaceInverse">@color/system_neutral1_100</item>
        <item name="colorOnSurfaceInverse">@color/system_neutral1_800</item>

        <!-- Outline -->
        <item name="colorOutline">@color/system_neutral2_400</item>
        <item name="colorOutlineVariant">@color/system_neutral2_700</item>

        <!-- Error (M3 baseline dark) -->
        <item name="colorError">#F2B8B5</item>
        <item name="colorOnError">#601410</item>
        <item name="colorErrorContainer">#8C1D18</item>
        <item name="colorOnErrorContainer">#F9DEDC</item>
    </style>

</resources>
