    <!-- AresLauncher §10 (no dock): the product vision has no hotseat/dock. Flipping this default
         is the whole change. Lawnchair already zeroes hotseatBarSizePx (DeviceProfile), swaps in
         DisabledHotseat (Hotseat), and hides the page indicator (Workspace) off this one flag.
         See design/component-verification-3.md §5. Left as a preference rather than hardcoded so
         it stays user-toggleable, per implementation-scope.md §12. -->
    <bool name="config_default_show_hotseat">false</bool>
    <bool name="config_default_always_reload_icons">true</bool>
    <bool name="config_default_dark_status_bar">false</bool>
    <bool name="config_default_show_notification_count">false</bool>
    <bool name="config_default_themed_hotseat_qsb">true</bool>
    <bool name="config_default_dock_search_bar_force_website">false</bool>
    <bool name="config_default_rounded_widgets">true</bool>
    <bool name="config_default_allow_widget_overlap">false</bool>
    <bool name="config_default_force_widget_resize">false</bool>
    <bool name="config_default_widget_unlimited_size">false</bool>
    <bool name="config_default_show_status_bar">true</bool>
    <bool name="config_default_remember_position">false</bool>
    <bool name="config_default_dynamic_hide_status_bar_clock">false</bool>
    <bool name="config_default_search_bar_background">true</bool>
    <bool name="config_default_show_scrollbar">true</bool>
    <bool name="config_default_show_top_shadow">true</bool>
    <bool name="config_default_lock_home_screen">false</bool>
    <bool name="config_default_lock_home_screen_on_popup">false</bool>
    <bool name="config_default_edit_home_screen_on_popup">false</bool>
    <bool name="config_default_show_system_settings_entry_on_popup">false</bool>
    <bool name="config_default_hide_app_drawer_search_bar">false</bool>
    <!-- AresLauncher §19: no tick on home -> app list. The user asked for it to go ("when going
         from homepage to app list there's a little vibrate, let's disable that"), and this is the
         one switch that covers it without touching any other haptic: AllAppsTransitionController
         gates its whole NORMAL -> ALL_APPS feedback block on this preference, both the MSDL token
         and the VIRTUAL_KEY fallback. Long-press feedback comes from entirely separate call sites
         (WorkspaceTouchListener, LauncherDragController) and is deliberately left alone.
         Still a user-facing toggle in App Drawer settings, so it is reversible without a build. -->
    <bool name="config_default_app_drawer_haptic_feedback">false</bool>
    <bool name="config_default_show_hidden_apps_in_search">false</bool>
    <bool name="config_default_enable_smart_hide">false</bool>
    <!-- AresLauncher: no predicted-apps row above the app list. The system taskbar already gives
         one-tap access to favourites, so a second favourites strip above an alphabetical list was
         redundant and cost a screenful of scroll before reaching "A".

         Done through Lawnchair's own preference rather than by excluding PredictionRowView from
         FloatingHeaderView's row scan: that left findFixedRowByType() returning null and
         QuickstepLauncher.dump() NPE'd on it, crash-looping the launcher on any dumpsys. Keeping
         the row registered but GONE is the supported path (getExpectedHeight() already returns 0
         and shouldDraw() false in that state), and it stays user-reversible in settings. -->
    <bool name="config_default_show_suggested_apps_at_drawer_top">false</bool>
    <bool name="config_default_enable_font_selection">true</bool>
    <bool name="config_default_enable_smartspace_calendar_selection">true</bool>
    <bool name="config_default_dts2">true</bool>
    <bool name="config_default_auto_show_keyboard_in_drawer">false</bool>
    <bool name="config_default_show_icon_labels_on_home_screen">true</bool>
    <bool name="config_default_show_icon_labels_in_drawer">true</bool>
    <bool name="config_default_enable_fuzzy_search">false</bool>
    <!-- AresLauncher: At a Glance is off by default. It occupied grid row 0 of the home page and
         forced AresHomeListView to start below it; with it gone the masonry grid starts at the top
         of the page. The offset logic is deliberately kept (it reads the pinned item's bounds and
         returns 0 when absent), so re-enabling this in settings still lays out correctly. -->
    <bool name="config_default_enable_smartspace">false</bool>
    <!-- AresLauncher 2026-09-01: default the Google Discover "-1" feed ON to test whether the Google
         app's DrawerOverlayService binds + renders for our caller package (design/discover-feed-investigation.md). -->
    <bool name="config_default_enable_feed">true</bool>
