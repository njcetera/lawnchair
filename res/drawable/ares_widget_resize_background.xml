<?xml version="1.0" encoding="utf-8"?><!--
     AresLauncher §6 - backing shape for the widget resize chevron in edit mode.

     Deliberately its own drawable rather than reusing ares_search_background: that one is a 28dp
     rounded rectangle tuned to read as a circle at 56dp AND as a pill once the search affordance
     expands. Sharing it would mean a later tweak to the search morph silently restyled the resize
     control, which is exactly the class of coupling this project has been bitten by.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/popupColorPrimary" />
</shape>
