<?xml version="1.0" encoding="utf-8"?><!--
     AresLauncher §6: the resize affordance shown on a resizable widget while the home grid is in
     edit mode. Tapping it cycles the widget through its allowed sizes (requirements-alignment.md
     §4). There are no drag handles, so this glyph is the entire resize UI.

     Drawn as diagonal corner arrows rather than a single chevron: the gesture is "change size",
     not "expand in one direction", and the cycle can shrink as well as grow. Reads at 28dp.
     (Note for editors: XML comments cannot contain a double hyphen.)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/textColorPrimary">

    <!-- Top-left arrow head and shaft. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,4h7v2H7.41l4.3,4.29 -1.42,1.42 -4.29,-4.3V11H4V4z" />

    <!-- Bottom-right arrow head and shaft, rotationally symmetric with the above. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M20,20h-7v-2h3.59l-4.3,-4.29 1.42,-1.42 4.29,4.3V13h2v7z" />
</vector>
