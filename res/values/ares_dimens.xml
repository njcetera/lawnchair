<?xml version="1.0" encoding="utf-8"?><!--
     AresLauncher row metrics, shared by the vertical home list and the app-list pane so both
     surfaces stay visually consistent. Niagara-style: small de-emphasised icon on the left, label
     as the dominant element, generous row height. See design/implementation-scope.md §8.

     These are a tuning starting point, not a derived spec. The sparse/text-forward look is a
     taste call. Adjust here and both surfaces follow.
-->
<resources>
    <!-- Row height. Taller than a dense list row, well short of a grid cell.
         Reduced 64dp -> 52dp: on a real device the app list runs to hundreds of entries and 64dp
         rows made scrolling to the end take too long. 52dp still clears the 44dp minimum hit
         target with room to spare and keeps the airy, text-forward feel; going lower starts to
         read like a stock dense drawer, which is the look this deliberately avoids. -->
    <dimen name="ares_app_row_height">52dp</dimen>

    <!-- Icon is deliberately smaller than the stock all-apps grid icon (~48-56dp) so the label
         reads as the primary element. Trimmed with the row height so the icon keeps roughly the
         same proportion of the row rather than crowding it. -->
    <dimen name="ares_app_row_icon_size">32dp</dimen>

    <!-- Label is the dominant element, so slightly larger than the stock icon label. -->
    <dimen name="ares_app_row_text_size">17sp</dimen>

    <!-- Leading inset for the icon, and the gap between icon and label. -->
    <dimen name="ares_app_row_padding_horizontal">24dp</dimen>
    <dimen name="ares_app_row_drawable_padding">16dp</dimen>

    <!-- Letter section headers (A / B / C) in the app list. Deliberately LIGHTER than an app row:
         smaller text, shorter height, de-emphasised colour. The letter is a signpost, not content,
         so it should recede next to the 17sp app labels it groups. Leading inset matches the row
         padding so letters and icons share one left edge. -->
    <!-- Trimmed alongside the row height: with ~26 letter groups in a real app list, header
         chrome is a meaningful share of total scroll length. -->
    <dimen name="ares_section_header_height">32dp</dimen>
    <dimen name="ares_section_header_text_size">13sp</dimen>
    <!-- Extra breathing room above a header so each letter group reads as a distinct block.
         None below: the header should sit close to the apps it introduces. -->
    <dimen name="ares_section_header_padding_top">10dp</dimen>

    <!-- §17 search affordance. Collapsed it is a circle of this size in the bottom-right corner;
         expanded it grows to the pane width less twice the resting margin. -->
    <dimen name="ares_search_collapsed_size">56dp</dimen>
    <dimen name="ares_search_icon_padding">16dp</dimen>
    <dimen name="ares_search_input_start_margin">24dp</dimen>

    <!-- Gap from the pane edges when resting. Clears the gesture-nav bar at the bottom. -->
    <dimen name="ares_search_margin_horizontal">16dp</dimen>
    <dimen name="ares_search_margin_bottom">24dp</dimen>

    <!-- §6 widget resize affordance, shown on resizable widgets in edit mode only.
         28dp is below the 44dp hit-target minimum on purpose: the touch target is expanded to
         ares_widget_resize_touch_size by AresWidgetResize, so the glyph can stay small enough not
         to cover the widget it sits on while remaining comfortably tappable. -->
    <dimen name="ares_widget_resize_chevron_size">28dp</dimen>
    <dimen name="ares_widget_resize_touch_size">48dp</dimen>
    <!-- Inset from the widget's bottom-end corner. -->
    <dimen name="ares_widget_resize_margin">4dp</dimen>

    <!-- Remove (x) affordance, shown on every home item in edit mode, top-start corner.
         Shares ares_widget_resize_touch_size and _margin so the two affordances are the same
         physical inset - they sit on opposite corners of the same tile, and a mismatch reads as a
         mistake.

         This is the size of the *drawn* badge, not of its touch target. The target stays 48dp; the
         badge is composed at this size and centred inside it (see ares_remove_badge.xml). Painting
         the backdrop across the full target instead made the circle nearly as wide as a 1x1 app
         icon, which read as a blob beside the icon rather than a badge on it. 28dp matches the
         resize chevron so the two corners carry equal visual weight. -->
    <dimen name="ares_remove_badge_size">28dp</dimen>
    <!-- The cross inside that circle. Inset enough to leave a visible ring of backdrop around it,
         so the glyph reads against a busy icon rather than blending into it. -->
    <dimen name="ares_remove_badge_glyph_size">18dp</dimen>

    <!-- §14 / §21 edit-mode grid overlay. Both are drawn by AresEditGrid and are meant to read as
         one system: dots mark where things CAN go, the outline marks what an item currently DOES
         occupy. Kept small and faint on purpose - they sit under and over the icons respectively,
         and anything heavier competes with the content rather than describing it. -->
    <dimen name="ares_edit_grid_dot_radius">2dp</dimen>
    <dimen name="ares_edit_cell_outline_width">1dp</dimen>
    <!-- Matches the corner softness of the icon and widget shapes it traces, so the outline reads
         as the cell's edge rather than as a box drawn on top of one. -->
    <dimen name="ares_edit_cell_outline_radius">16dp</dimen>

    <!-- The dwell drop-target ring (AresFolderDrop). Heavier than the cell outline on purpose:
         the outline is a passive hint, this is the launcher answering "release now and it goes in
         here" after the user has deliberately held still for half a second. Shares the outline's
         corner radius so the two read as the same shape at different weights. -->
    <dimen name="ares_drop_ring_width">3dp</dimen>
</resources>
