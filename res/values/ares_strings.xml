<?xml version="1.0" encoding="utf-8"?>
<!-- Strings owned by AresLauncher. Kept out of res/values/strings.xml, which is vendored from
     Launcher3, so upstream merges stay clean and the blast radius of a change here is visible.
     See design/change-practices.md. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Content descriptions for the edit-mode affordances (§9D / §6).

         Both name the item they act on. The plain labels they replace ("Remove", "Resize") are
         fine on a screen where one such control exists, and useless on a home grid where every
         tile carries one: a screen-reader user swiping through edit mode heard "Remove" six times
         with nothing to distinguish them, and no way to tell which tile was about to go.

         The visible glyph is unchanged — this is what is spoken, not what is drawn. -->

    <!-- Spoken label for the x badge. %1$s is the item's own name, e.g. "Chrome".
         Says "from home screen" deliberately: x takes the item off the home screen and never
         uninstalls it, and that distinction is exactly what a user who cannot see the result
         needs stated. -->
    <string name="ares_remove_from_home">Remove <xliff:g id="item_name" example="Chrome">%1$s</xliff:g> from home screen</string>

    <!-- Spoken label for the ! badge, which raises the context menu a long-press used to raise.
         %1$s is the item's own name, e.g. "Chrome". "More options" rather than "App info": for an
         icon the control opens the whole menu (shortcuts, App info, Uninstall, Widgets), so naming
         a single entry inside it would describe the control by one of its outcomes. -->
    <string name="ares_open_item_menu">More options for <xliff:g id="item_name" example="Chrome">%1$s</xliff:g></string>

    <!-- Fallback for the same badge when the item has no readable name. -->
    <string name="ares_open_item_menu_generic">More options</string>

    <!-- Spoken label for the resize chevron. %1$s is the widget's own name, e.g. "Analog". -->
    <string name="ares_resize_item">Resize <xliff:g id="item_name" example="Analog">%1$s</xliff:g></string>

    <!-- §17 app-list search hint. "Search" (not "Search apps"): the field now searches
         apps, contacts, files, settings and the web, so the app-only label under-promised. Scoped
         to the Ares fob so the shared all_apps_search_bar_hint (stock/taskbar) is untouched. -->
    <string name="ares_search_bar_hint">Search</string>

    <!-- WP folders (design/wp-folder-design.md). Label on the edit-mode FAB that creates a new,
         empty Windows-Phone-style folder. -->
    <string name="ares_wp_fab_label">New folder</string>

    <!-- Default title a freshly-created empty WP folder carries until the owner renames it. -->
    <string name="ares_wp_folder_default_title">Folder</string>

    <!-- Spoken label for the extract badge on an expanded WP-folder child. %1$s is the app's name.
         "Take out of folder" (not "remove"): extract moves the app onto the home grid, it does not
         take it off home and never uninstalls. Distinct wording for a distinct action (BL-5/M4). -->
    <string name="ares_extract_from_folder">Take <xliff:g id="item_name" example="Chrome">%1$s</xliff:g> out of folder</string>

    <!-- Phase 3 #5: title of the rename dialog raised by tapping a WP folder tile in edit mode.
         Renaming stamps FLAG_MANUAL_FOLDER_NAME so the loader's auto-labeler never overwrites it. -->
    <string name="ares_wp_rename_title">Rename folder</string>

    <!-- Edit-mode home-grid column stepper (owner 2026-08-26). %1$d is the column count. -->
    <plurals name="ares_home_columns_label">
        <item quantity="one"><xliff:g id="count" example="4">%1$d</xliff:g> column</item>
        <item quantity="other"><xliff:g id="count" example="4">%1$d</xliff:g> columns</item>
    </plurals>

</resources>
